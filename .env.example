# ============================================================================
# TÁ NA MESA (by A2i Solutions & Alô Classificados)
# VARIÁVEIS DE AMBIENTE OBRIGATÓRIAS NA VERCEL (Settings -> Environment Variables)
# ============================================================================

# 1. URL Pública do Projeto no Supabase (Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://SEU_PROJETO_ID.supabase.co"

# 2. Chave Pública Anônima (anon / public key) — Usada no Frontend, Login e WebSockets Realtime
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 3. Chave Secreta de Administração (service_role key) — Usada APENAS no Backend (/api/webhooks/pix)
#    NUNCA exponha com prefixo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 4. UUID da Loja Padrão (Vitrine Principal `/` quando acessada sem `/loja/[slug]`)
NEXT_PUBLIC_DEFAULT_STORE_ID="00000000-0000-0000-0000-000000000001"

# 5. Segredo de Validação do Webhook Pix (Asaas / Mercado Pago / Efí) — Opcional, recomendado em Produção
PIX_WEBHOOK_SECRET="segredo-webhook-pix-a2i-solutions"
